# Copy these names into an untracked env file. Do not commit secrets.
# The process refuses to start until the required values are present.
COSTCAP_ORIGIN=https://app.costcap.dev
PORT=3000
COSTCAP_STORE_PATH=/data/costcap.json
COSTCAP_EMAIL_PROVIDER=brevo
BREVO_API_KEY=
COSTCAP_EMAIL_FROM=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional. Set only for an owner-authorized organization.
# COSTCAP_ALERT_EMAILS=
# COSTCAP_SLACK_WEBHOOK=
# COSTCAP_ALERT_ORG_ID=
