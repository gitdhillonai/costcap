# Copy these names into an untracked env file. Do not commit secrets.
# The process refuses to start until the required values are present.
COSTCAP_ORIGIN=https://app.costcap.dev
PORT=3000
COSTCAP_STORE_PATH=/data/costcap.json
COSTCAP_EMAIL_PROVIDER=brevo
BREVO_API_KEY=
COSTCAP_EMAIL_FROM=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional. Set only for an owner-authorized organization.
# COSTCAP_ALERT_EMAILS=
# COSTCAP_SLACK_WEBHOOK=
# COSTCAP_ALERT_ORG_ID=
# Optional $19/month hosted workspace plan. Enable only after live readback.
# COSTCAP_BILLING=enabled
# COSTCAP_STRIPE_SECRET_KEY= restricted live key via secure deployment secrets
# COSTCAP_STRIPE_WEBHOOK_SECRET= signing secret via secure deployment secrets
# COSTCAP_STRIPE_ACCOUNT_ID= Persoon.ai Inc account ID
# COSTCAP_STRIPE_PRICE_ID= verified USD 1900/month licensed CostCap price
